# Copia este archivo a `.env.local` (no se versiona) y completa con los datos
# del proyecto Supabase: Project Settings → API Keys.
# En Vercel, las mismas variables van en Project Settings → Environment Variables.

SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publica: `sb_publishable_…` (o la `anon` heredada).
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: `sb_secret_…` (o la `service_role` heredada). Solo servidor.
SUPABASE_SECRET_KEY=
# Origenes web extra permitidos por CORS, separados por coma. La app nativa
# (capacitor://localhost, https://localhost) ya esta permitida.
ALLOWED_ORIGINS=http://localhost:4200
# Switch del acceso desde el navegador en la build de Vercel: `off` (por
# defecto, la web solo muestra "disponible solo en la app") o `mobile` (los
# navegadores móviles usan la app; útil para la presentación). Exige redeploy.
NEQUE_WEB_ACCESS=off
# Correo de invitacion con Brevo (ver docs/runbooks/correo-brevo.md). Sin la
# clave, la invitacion se emite igual y el entrenador comparte el enlace.
BREVO_API_KEY=
# Remitente verificado en Brevo.
MAIL_FROM=
MAIL_FROM_NAME=Ñeque
# Origen publico de la app para los enlaces de los correos.
PUBLIC_APP_URL=https://neque-ten.vercel.app
