# Copia este archivo a `.env.local` (no se versiona) y completa con los datos
# del proyecto Supabase: Project Settings → API Keys.
# En Vercel, las mismas variables van en Project Settings → Environment Variables.

SUPABASE_URL=https://<project-ref>.supabase.co
# Clave publica: `sb_publishable_…` (o la `anon` heredada).
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta: `sb_secret_…` (o la `service_role` heredada). Solo servidor.
SUPABASE_SECRET_KEY=
# Origenes web extra permitidos por CORS, separados por coma. La app nativa
# (capacitor://localhost, https://localhost) ya esta permitida.
ALLOWED_ORIGINS=http://localhost:4200
