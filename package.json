{
  "name": "ui-any-neque-mobile-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "jest --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,html,scss,json,md}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "cap:sync": "npx cap sync",
    "cap:build": "ng build --configuration production && npx cap copy",
    "prepare": "husky",
    "dev:api": "tsx watch --tsconfig tsconfig.server.json server/dev.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "create:trainer": "tsx --tsconfig tsconfig.server.json server/scripts/create-trainer.ts",
    "create:student": "tsx --tsconfig tsconfig.server.json server/scripts/create-student.ts"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@capacitor-community/keep-awake": "^5.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/screen-orientation": "^6.0.4",
    "@capacitor/share": "^6.0.0",
    "@hono/node-server": "^1.19.18",
    "@lucide/angular": "^1.20.0",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.16",
    "jose": "^5.10.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zod": "^3.25.76",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@capacitor/cli": "^6.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@testing-library/angular": "^16.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.5.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^9.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.23.15",
    "typescript": "~5.3.0"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!.*\\.mjs$|@ionic|@stencil|ionicons)"
    ],
    "moduleNameMapper": {
      "^ionicons/components/(.*)$": "<rootDir>/node_modules/ionicons/components/$1",
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@env/(.*)$": "<rootDir>/src/environments/$1",
      "^@shared/(.*)$": "<rootDir>/src/app/ui/shared/$1",
      "^@testing/(.*)$": "<rootDir>/src/testing/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "server/domain/**/*.ts",
      "server/infrastructure/mappers.ts",
      "!src/**/*.module.ts",
      "!src/**/*.routes.ts",
      "!src/main.ts",
      "!src/environments/**",
      "!src/testing/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 80,
        "branches": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary",
      "json"
    ]
  }
}
